# Public fallback. The persisted Configuracion value takes precedence.
NEXT_PUBLIC_WHATSAPP_NUMBER=5493412345678

# Local PostgreSQL. In Vercel use Supabase Transaction pooler (port 6543) here.
DATABASE_URL=postgresql://kova:kova_local_password@localhost:54329/kova_acad_turnos

# Used by Prisma migrations. In Supabase use Session pooler (port 5432).
DIRECT_URL=postgresql://kova:kova_local_password@localhost:54329/kova_acad_turnos

# Authentication. Replace every value outside local development.
AUTH_SECRET=replace-with-at-least-32-random-characters
AUTH_TRUST_HOST=true
ADMIN_EMAIL=alai@kova.local
ADMIN_PASSWORD=KovaLocal123!

# Required to enable signed portfolio uploads.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
